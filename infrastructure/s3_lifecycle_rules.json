{
  "_comment": "S3 Lifecycle Rules — Auto-purge archive, athena-results, rejected",
  "_purpose": "Automates retention policy: archive=2 days, athena-results=7 days, rejected=30 days. processed/ and logs/ have NO expiry.",
  "_apply": "aws s3api put-lifecycle-configuration --bucket <BUCKET_NAME> --lifecycle-configuration file://this-file.json",

  "Rules": [
    {
      "ID": "purge-archive-after-2-days",
      "Status": "Enabled",
      "Filter": {
        "Prefix": "archive/"
      },
      "Expiration": {
        "Days": 2
      }
    },
    {
      "ID": "purge-athena-results-7-days",
      "Status": "Enabled",
      "Filter": {
        "Prefix": "athena-results/"
      },
      "Expiration": {
        "Days": 7
      }
    },
    {
      "ID": "purge-rejected-30-days",
      "Status": "Enabled",
      "Filter": {
        "Prefix": "rejected/"
      },
      "Expiration": {
        "Days": 30
      }
    }
  ]
}
