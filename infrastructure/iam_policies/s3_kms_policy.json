{
  "_comment": "S3 + KMS Access Policy for EMR Serverless Role",
  "_purpose": "Grants least-privilege S3 read/write and KMS encrypt/decrypt to the EMR Serverless execution role.",
  "_attach_to": "EMR_Serverless_ExecutionRole (as inline or managed policy)",
  "_replace": "<BUCKET_NAME> with your actual bucket name, <KMS_KEY_ARN> with your KMS key ARN",

  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "S3ReadLandingAndConfig",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": [
        "arn:aws:s3:::<BUCKET_NAME>/landing/*",
        "arn:aws:s3:::<BUCKET_NAME>/config/*",
        "arn:aws:s3:::<BUCKET_NAME>/scripts/*"
      ]
    },
    {
      "Sid": "S3WriteProcessedArchiveRejectedLogs",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:PutObjectAcl"
      ],
      "Resource": [
        "arn:aws:s3:::<BUCKET_NAME>/processed/*",
        "arn:aws:s3:::<BUCKET_NAME>/archive/*",
        "arn:aws:s3:::<BUCKET_NAME>/rejected/*",
        "arn:aws:s3:::<BUCKET_NAME>/logs/*"
      ]
    },
    {
      "Sid": "S3DeleteLandingAfterArchive",
      "Effect": "Allow",
      "Action": "s3:DeleteObject",
      "Resource": "arn:aws:s3:::<BUCKET_NAME>/landing/*"
    },
    {
      "Sid": "S3ListBucket",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": "arn:aws:s3:::<BUCKET_NAME>"
    },
    {
      "Sid": "KMSEncryptDecrypt",
      "Effect": "Allow",
      "Action": [
        "kms:Encrypt",
        "kms:Decrypt",
        "kms:GenerateDataKey",
        "kms:GenerateDataKeyWithoutPlaintext",
        "kms:DescribeKey"
      ],
      "Resource": "<KMS_KEY_ARN>"
    },
    {
      "Sid": "CloudWatchMetrics",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:PutMetricData"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "cloudwatch:namespace": "DataPipeline"
        }
      }
    }
  ]
}
