{
  "_comment": "EMR Cluster Configuration — Transient cluster for 1GB PySpark ETL",
  "_purpose": "Complete cluster spec for aws emr create-cluster CLI or Airflow EmrCreateJobFlowOperator",
  "_cost": "~$0.06 per run (8 min job on m5.xlarge with Spot core node)",
  "_replace": "<BUCKET_NAME>, <SUBNET_ID>, <KMS_KEY_ARN>, <EMR_EC2_INSTANCE_PROFILE>",

  "Name": "data-pipeline-etl-cluster",
  "ReleaseLabel": "emr-7.1.0",
  "LogUri": "s3://<BUCKET_NAME>/logs/emr/",

  "Applications": [
    { "Name": "Spark" }
  ],

  "Instances": {
    "KeepJobFlowAliveWhenNoSteps": false,
    "TerminationProtected": false,

    "InstanceGroups": [
      {
        "Name": "Master - On-Demand",
        "InstanceRole": "MASTER",
        "InstanceType": "m5.xlarge",
        "InstanceCount": 1,
        "Market": "ON_DEMAND",
        "EbsConfiguration": {
          "EbsBlockDeviceConfigs": [
            {
              "VolumeSpecification": {
                "VolumeType": "gp3",
                "SizeInGB": 32
              },
              "VolumesPerInstance": 1
            }
          ]
        }
      },
      {
        "Name": "Core - Spot (60% savings)",
        "InstanceRole": "CORE",
        "InstanceType": "m5.xlarge",
        "InstanceCount": 1,
        "Market": "SPOT",
        "BidPrice": "OnDemandPrice",
        "EbsConfiguration": {
          "EbsBlockDeviceConfigs": [
            {
              "VolumeSpecification": {
                "VolumeType": "gp3",
                "SizeInGB": 32
              },
              "VolumesPerInstance": 1
            }
          ]
        }
      }
    ]
  },

  "AutoTerminationPolicy": {
    "IdleTimeout": 900
  },

  "Configurations": [
    {
      "Classification": "spark-defaults",
      "Properties": {
        "spark.driver.memory": "2g",
        "spark.driver.cores": "2",
        "spark.executor.memory": "4g",
        "spark.executor.cores": "2",
        "spark.executor.instances": "2",
        "spark.sql.adaptive.enabled": "true",
        "spark.sql.adaptive.coalescePartitions.enabled": "true",
        "spark.sql.shuffle.partitions": "8",
        "spark.serializer": "org.apache.spark.serializer.KryoSerializer",
        "spark.sql.parquet.compression.codec": "snappy",
        "spark.dynamicAllocation.enabled": "false",
        "spark.hadoop.fs.s3a.server-side-encryption-algorithm": "SSE-KMS",
        "spark.hadoop.fs.s3a.server-side-encryption.key": "<KMS_KEY_ARN>"
      }
    },
    {
      "Classification": "spark-log4j2",
      "Properties": {
        "rootLogger.level": "WARN",
        "logger.etl.name": "com.datapipeline",
        "logger.etl.level": "INFO"
      }
    }
  ],

  "JobFlowRole": "<EMR_EC2_INSTANCE_PROFILE>",
  "ServiceRole": "EMR_DefaultRole",

  "Tags": [
    { "Key": "Project", "Value": "data-pipeline" },
    { "Key": "Environment", "Value": "dev" },
    { "Key": "CostCenter", "Value": "data-engineering" },
    { "Key": "AutoTerminate", "Value": "true" }
  ]
}
